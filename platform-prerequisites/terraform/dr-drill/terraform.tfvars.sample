# platform-prerequisites/terraform/dr-drill/terraform.tfvars.sample
# Copy to terraform.tfvars and fill in:
#   cluster_name        - the EKS cluster name (from eks-platform.tfvars, e.g. "oms-uat")
#   aws_region           - AWS region for the target environment
#   expected_account_id  - the approved AWS account ID for deployment (guards against
#                          accidentally applying against the wrong account)
cluster_name        = ""
aws_region          = ""
expected_account_id = ""
