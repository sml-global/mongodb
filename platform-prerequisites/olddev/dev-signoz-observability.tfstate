tle\":\"Heap Memory Allocated\",\"yAxisUnit\":\"bytes\"},{\"contextLinks\":{\"linksData\":[]},\"description\":\"Physical memory used by each collector instance, including Go runtime overhead.\",\"id\":\"g_rss_mem\",\"panelTypes\":\"graph\",\"query\":{\"builder\":{\"queryData\":[{\"aggregations\":[{\"metricName\":\"otelcol_process_memory_rss\",\"spaceAggregation\":\"sum\",\"temporality\":\"unspecified\",\"timeAggregation\":\"avg\"}],\"dataSource\":\"metrics\",\"expression\":\"A\",\"filter\":{\"expression\":\"service.name IN $service_name\"},\"groupBy\":[{\"dataType\":\"string\",\"key\":\"service.instance.id\",\"type\":\"resource\"}],\"legend\":\"instance: {{service.instance.id}}\",\"queryName\":\"A\",\"stepInterval\":60}],\"queryFormulas\":[]},\"queryType\":\"builder\"},\"selectedLogFields\":[],\"selectedTracesFields\":[],\"thresholds\":[],\"title\":\"Process RSS Memory\",\"yAxisUnit\":\"bytes\"},{\"contextLinks\":{\"linksData\":[]},\"description\":\"CPU seconds consumed per second, per collector instance. Values near the number of available cores mean the collector is CPU-saturated.\",\"id\":\"g_cpu\",\"panelTypes\":\"graph\",\"query\":{\"builder\":{\"queryData\":[{\"aggregations\":[{\"metricName\":\"otelcol_process_cpu_seconds\",\"spaceAggregation\":\"sum\",\"temporality\":\"cumulative\",\"timeAggregation\":\"rate\"}],\"dataSource\":\"metrics\",\"expression\":\"A\",\"filter\":{\"expression\":\"service.name IN $service_name\"},\"groupBy\":[{\"dataType\":\"string\",\"key\":\"service.instance.id\",\"type\":\"resource\"}],\"legend\":\"instance: {{service.instance.id}}\",\"queryName\":\"A\",\"stepInterval\":60}],\"queryFormulas\":[]},\"queryType\":\"builder\"},\"selectedLogFields\":[],\"selectedTracesFields\":[],\"thresholds\":[],\"title\":\"CPU Usage (user + system)\",\"yAxisUnit\":\"none\"},{\"contextLinks\":{\"linksData\":[]},\"description\":\"Heap allocation throughput in bytes per second, per collector instance. High rates drive GC pressure and CPU overhead.\",\"id