# EKS platform schema fragment.
# Optional until later task-specific environment files begin populating these keys.

EKS_KUBERNETES_VERSION|optional|enum:1.30,1.31|-
EKS_AUTHENTICATION_MODE|optional|enum:API,API_AND_CONFIG_MAP|-
EKS_ENDPOINT_PUBLIC_ACCESS|optional|enum:true,false|-
EKS_ENDPOINT_PRIVATE_ACCESS|optional|enum:true,false|-
EKS_DELETION_PROTECTION|optional|enum:true,false|-

EKS_VPC_CIDR|optional|ipv4-cidr|-
EKS_CONNECTED_CIDR|optional|ipv4-cidr|-
EKS_AZ_LAYOUT_MODE|optional|fixed:one-per-az|-
EKS_AZ_COUNT|optional|fixed:3|-
EKS_PRIVATE_SUBNET_A_CIDR|optional|ipv4-cidr|-
EKS_PRIVATE_SUBNET_B_CIDR|optional|ipv4-cidr|-
EKS_PRIVATE_SUBNET_C_CIDR|optional|ipv4-cidr|-
EKS_PUBLIC_SUBNET_A_CIDR|optional|ipv4-cidr|-
EKS_PUBLIC_SUBNET_B_CIDR|optional|ipv4-cidr|-
EKS_PUBLIC_SUBNET_C_CIDR|optional|ipv4-cidr|-
EKS_NAT_GATEWAY_COUNT|optional|fixed:3|-

EKS_NODE_INSTANCE_TYPE|optional|enum:t3.medium,t3.large,m5.large,m5.xlarge|-
EKS_NODE_MIN_SIZE|optional|integer:1:20|-
EKS_NODE_DESIRED_SIZE|optional|integer:1:20|-
EKS_NODE_MAX_SIZE|optional|integer:1:20|-
EKS_NODE_ROOT_VOLUME_GB|optional|integer:20:1000|-
EKS_SPOT_ENABLED|optional|enum:true,false|-

EKS_EFS_ENABLED|optional|enum:true,false|-
EKS_EFS_THROUGHPUT_MODE|optional|enum:elastic,provisioned|-
EKS_EFS_BACKUP_ENABLED|optional|enum:true,false|-
EKS_BACKUP_RETENTION_DAYS|optional|integer:35:365|-

EKS_ADDON_DELIVERY_MODE|optional|enum:managed-addon,helm-fallback|-
EKS_ENABLE_VPC_CNI|optional|enum:true,false|-
EKS_ENABLE_COREDNS|optional|enum:true,false|-
EKS_ENABLE_KUBE_PROXY|optional|enum:true,false|-
EKS_ENABLE_EBS_CSI|optional|enum:true,false|-
EKS_ENABLE_EFS_CSI|optional|enum:true,false|-
EKS_ENABLE_POD_IDENTITY_AGENT|optional|enum:true,false|-
EKS_ENABLE_CLUSTER_AUTOSCALER|optional|enum:true,false|-
EKS_ENABLE_METRICS_SERVER|optional|enum:true,false|-

@constraint|cidr-contained-by|EKS_CONNECTED_CIDR,EKS_VPC_CIDR|-
@constraint|cidr-contained-by|EKS_PRIVATE_SUBNET_A_CIDR,EKS_VPC_CIDR|-
@constraint|cidr-contained-by|EKS_PRIVATE_SUBNET_B_CIDR,EKS_VPC_CIDR|-
@constraint|cidr-contained-by|EKS_PRIVATE_SUBNET_C_CIDR,EKS_VPC_CIDR|-
@constraint|cidr-contained-by|EKS_PUBLIC_SUBNET_A_CIDR,EKS_VPC_CIDR|-
@constraint|cidr-contained-by|EKS_PUBLIC_SUBNET_B_CIDR,EKS_VPC_CIDR|-
@constraint|cidr-contained-by|EKS_PUBLIC_SUBNET_C_CIDR,EKS_VPC_CIDR|-
@constraint|cidr-nonoverlap|EKS_PRIVATE_SUBNET_A_CIDR,EKS_PRIVATE_SUBNET_B_CIDR,EKS_PRIVATE_SUBNET_C_CIDR,EKS_PUBLIC_SUBNET_A_CIDR,EKS_PUBLIC_SUBNET_B_CIDR,EKS_PUBLIC_SUBNET_C_CIDR|-
@constraint|integer-order|EKS_NODE_MIN_SIZE,EKS_NODE_DESIRED_SIZE,EKS_NODE_MAX_SIZE|-
