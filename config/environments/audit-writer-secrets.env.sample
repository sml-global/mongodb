# Sample secrets file for scripts/create-audit-writer-user.sh.
#
# Copy to config/environments/<env>-secrets.env (e.g. dev-secrets.env,
# uat-secrets.env) and either leave AUDIT_WRITER_PASSWORD blank (the script
# will generate a strong password on first run and persist it back into
# this file) or set a specific value yourself before the first run.
#
# This file is intentionally NOT validated by config/environment-schema/ --
# that schema is for non-secret infra config only. Never commit the real
# <env>-secrets.env file (see .gitignore).

AUDIT_WRITER_PASSWORD=
