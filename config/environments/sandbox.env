# Sandbox Environment Configuration
# Used for Phase 2 validation in us-east-1 (cheapest region)
# Production AWS Account (632674123947) as temporary sandbox for Phase 2 testing
# UAT Account (672172129937) reserved for actual UAT environment work

export ENVIRONMENT="sandbox"
export AWS_REGION="us-east-1"
export EKS_PLATFORM_STATE_BUCKET="oms-sandbox-eks-tfstate"
export AWS_PROFILE="sandbox"

# Terraform backend variables
# Note: State locking uses S3-native file locking (use_lockfile=true)
# Modern approach: eliminates need for separate DynamoDB table
export TF_BACKEND_BUCKET="$EKS_PLATFORM_STATE_BUCKET"
export TF_BACKEND_REGION="$AWS_REGION"
