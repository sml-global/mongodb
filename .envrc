#!/usr/bin/env bash
# Pins gh CLI (and any tool reading GH_TOKEN/GITHUB_TOKEN) to the sml-admin
# account whenever a shell is inside this repo directory, regardless of
# gh's global active-account state. Looked up dynamically (not hardcoded)
# so the token stays current and nothing secret is stored in this file.
#
# Requires: direnv (brew install direnv, hooked into your shell), and
# gh auth login having already authenticated the sml-admin account once
# on this machine (gh auth status should list it).

if command -v gh >/dev/null 2>&1; then
  SML_ADMIN_TOKEN="$(gh auth token --user sml-admin 2>/dev/null)"
  if [ -n "$SML_ADMIN_TOKEN" ]; then
    export GH_TOKEN="$SML_ADMIN_TOKEN"
    export GITHUB_TOKEN="$SML_ADMIN_TOKEN"
  else
    echo "WARNING: .envrc could not look up sml-admin gh token -- run gh auth login for that account" >&2
  fi
fi
